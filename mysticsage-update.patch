+#!/usr/bin/env python3
+"""Generate batch 2 articles - reads article data from JSON, generates pages."""
+import json, os
+
+# Read each article JSON and generate pages
+articles_dir = "/root/.openclaw/workspace/mysticsage/gen_articles_data"
+article_files = sorted([f for f in os.listdir(articles_dir) if f.endswith(".json")])
+
+# Read the article page template
+with open("/root/.openclaw/workspace/mysticsage/src/app/knowledge/what-is-bazi/page.tsx", "r") as f:
+    full = f.read()
+
+head, _, tail = full.partition("const CONTENT = ")
+_, _, tail = tail.partition("export default function")
+template = head + "const CONTENT = @@CONTENT@@;\n\nexport default function" + tail
+
+for af in article_files:
+    slug = af.replace(".json", "")
+    with open(f"{articles_dir}/{af}", "r") as f:
+        data = f.read()
+    
+    page = template.replace("@@CONTENT@@", data)
+    
+    dir_path = f"/root/.openclaw/workspace/mysticsage/src/app/knowledge/{slug}"
+    os.makedirs(dir_path, exist_ok=True)
+    with open(f"{dir_path}/page.tsx", "w", encoding="utf-8") as f:
+        f.write(page)
+    print(f"  ✅ knowledge/{slug}/")
+
+print(f"Generated {len(article_files)} article pages")
